{
    "name": "get_roles",
    "label": "Get roles",
    "description": "Retrieves role holders for a company — CEO, chair of the board, board members, power of procuration, authorized signatories. Can filter by role type and include people who have resigned.",
    "connection": "apiKey",
    "type": "action",
    "crud": "read",
    "parameters": [
        {
            "help": "Nine-digit Norwegian organization number (orgnr).",
            "name": "orgnr",
            "type": "text",
            "label": "Organization number",
            "required": true,
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Must be exactly 9 digits."
            }
        },
        {
            "help": "Filter by role type. Empty = all roles.",
            "name": "role_type",
            "type": "select",
            "label": "Role type",
            "default": "",
            "options": [
                {
                    "label": "All roles",
                    "value": ""
                },
                {
                    "label": "CEO / general manager",
                    "value": "daglig_leder"
                },
                {
                    "label": "Chair of the board",
                    "value": "styreleder"
                },
                {
                    "label": "Board member",
                    "value": "styremedlem"
                },
                {
                    "label": "Deputy board member",
                    "value": "varamedlem"
                },
                {
                    "label": "Power of procuration",
                    "value": "prokura"
                },
                {
                    "label": "Signature (authorized signatory)",
                    "value": "signatur"
                },
                {
                    "label": "Auditor",
                    "value": "revisor"
                }
            ]
        },
        {
            "help": "Include people who have resigned from the role.",
            "name": "include_historic",
            "type": "boolean",
            "label": "Include resigned",
            "default": false
        }
    ],
    "communication": {
        "url": "/api/v1/company/{{parameters.orgnr}}/roles",
        "method": "GET",
        "qs": {
            "include_historic": "{{if(parameters.include_historic, '1', '')}}",
            "role_type": "{{parameters.role_type}}"
        },
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organization number"
        },
        {
            "name": "roles",
            "type": "array",
            "label": "Roles",
            "spec": {
                "type": "collection",
                "spec": [
                    {
                        "name": "rolle_type",
                        "type": "text",
                        "label": "Role type (Styreleder, Daglig leder, ...)"
                    },
                    {
                        "name": "rolle_type_en",
                        "type": "text",
                        "label": "Role type (English)"
                    },
                    {
                        "name": "navn",
                        "type": "text",
                        "label": "Name"
                    },
                    {
                        "name": "fodselsaar",
                        "type": "text",
                        "label": "Birth year (4 digits, or empty)"
                    },
                    {
                        "name": "fra_dato",
                        "type": "text",
                        "label": "From date (YYYY-MM-DD)"
                    },
                    {
                        "name": "til_dato",
                        "type": "text",
                        "label": "To date (YYYY-MM-DD, empty if active)"
                    },
                    {
                        "name": "signatur_alene",
                        "type": "boolean",
                        "label": "Sole signature rights"
                    },
                    {
                        "name": "is_active",
                        "type": "boolean",
                        "label": "Currently active"
                    }
                ]
            }
        },
        {
            "name": "total_count",
            "type": "uinteger",
            "label": "Total number of roles"
        },
        {
            "name": "cached",
            "type": "boolean",
            "label": "Served from cache"
        }
    ]
}
