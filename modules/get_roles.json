{
    "name": "get_roles",
    "label": "Get roles",
    "description": "Get board members, managing director and proxy holders for a company. Optionally include retired roles.",
    "connection": "apiKey",
    "type": "action",
    "parameters": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organisation number",
            "required": true,
            "help": "9-digit Norwegian organisation number.",
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Organisation number must be exactly 9 digits."
            }
        },
        {
            "name": "role_type",
            "type": "select",
            "label": "Role type",
            "required": true,
            "default": "all",
            "options": [
                {"label": "All", "value": "all"},
                {"label": "Board", "value": "board"},
                {"label": "Managing director", "value": "managing_director"},
                {"label": "Proxy", "value": "proxy"}
            ]
        },
        {
            "name": "include_retired",
            "type": "boolean",
            "label": "Include retired roles",
            "default": false,
            "help": "Include historic role-holders that are no longer in position."
        }
    ],
    "communication": {
        "url": "{{connection.baseUrl}}/api/v1/company/{{parameters.orgnr}}/roles",
        "method": "GET",
        "qs": {
            "role_type": "{{parameters.role_type}}",
            "include_retired": "{{if(parameters.include_retired, 1, 0)}}"
        },
        "headers": {
            "Authorization": "Bearer {{connection.apiKey}}",
            "X-FR-Client": "make-firmaradar/0.1",
            "Accept": "application/json"
        },
        "response": {
            "output": "{{body}}",
            "error": {
                "message": "[{{statusCode}}] {{ifempty(body.error_code, '')}} {{ifempty(body.message, body.error)}}"
            }
        }
    },
    "interface": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organisasjonsnummer"
        },
        {
            "name": "roller",
            "type": "array",
            "label": "Roller",
            "spec": {
                "type": "collection",
                "spec": [
                    {"name": "navn", "type": "text", "label": "Navn"},
                    {"name": "rolle", "type": "text", "label": "Rolle"},
                    {"name": "fra_dato", "type": "date", "label": "Fra"},
                    {"name": "til_dato", "type": "date", "label": "Til (hvis fratrådt)"},
                    {"name": "fodselsaar", "type": "uinteger", "label": "Fødselsår"}
                ]
            }
        }
    ],
    "samples": {
        "orgnr": "999999999",
        "roller": [
            {"navn": "Person Nordmann", "rolle": "Styreleder", "fra_dato": "2018-03-15", "til_dato": null, "fodselsaar": 1972},
            {"navn": "Annen Person", "rolle": "Daglig leder", "fra_dato": "2020-06-01", "til_dato": null, "fodselsaar": 1985}
        ]
    }
}
