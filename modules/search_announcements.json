{
    "name": "search_announcements",
    "label": "Search announcements",
    "description": "Search BRREG announcements (kunngjøringer) across all companies — filter by type, free text and date range. Useful for monitoring legal events market-wide.",
    "connection": "apiKey",
    "type": "search",
    "parameters": [
        {
            "name": "type",
            "type": "text",
            "label": "Announcement type",
            "help": "Case-insensitive substring on the announcement type (e.g. 'konkurs', 'fusjon')."
        },
        {
            "name": "q",
            "type": "text",
            "label": "Free text",
            "help": "Free-text filter on the announcement."
        },
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organisation number",
            "help": "Optional exact 9-digit organisation number filter.",
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Organisation number must be exactly 9 digits."
            }
        },
        {
            "name": "from",
            "type": "date",
            "label": "From date",
            "help": "Earliest announcement date (YYYY-MM-DD). Default: 30 days back."
        },
        {
            "name": "to",
            "type": "date",
            "label": "To date",
            "help": "Latest announcement date (YYYY-MM-DD). Default: today. Range max 730 days."
        },
        {
            "name": "limit",
            "type": "uinteger",
            "label": "Max results",
            "default": 50,
            "validate": {"min": 1, "max": 200},
            "help": "Maximum number of announcements to return (1-200)."
        }
    ],
    "communication": {
        "url": "{{connection.baseUrl}}/api/v1/announcements/search",
        "method": "GET",
        "qs": {
            "type": "{{parameters.type}}",
            "q": "{{parameters.q}}",
            "orgnr": "{{parameters.orgnr}}",
            "from": "{{formatDate(parameters.from, 'YYYY-MM-DD')}}",
            "to": "{{formatDate(parameters.to, 'YYYY-MM-DD')}}",
            "limit": "{{parameters.limit}}"
        },
        "headers": {
            "Authorization": "Bearer {{connection.apiKey}}",
            "X-FR-Client": "make-firmaradar/0.1",
            "Accept": "application/json"
        },
        "response": {
            "output": "{{body.items}}",
            "error": {
                "message": "[{{statusCode}}] {{ifempty(body.error_code, '')}} {{ifempty(body.message, body.error)}}"
            }
        }
    },
    "interface": [
        {"name": "orgnr", "type": "text", "label": "Organisation number"},
        {"name": "navn", "type": "text", "label": "Company name"},
        {"name": "dato", "type": "date", "label": "Date"},
        {"name": "kunngjoring_type", "type": "text", "label": "Announcement type"},
        {"name": "category", "type": "text", "label": "Category"},
        {"name": "hendelse_type", "type": "text", "label": "Event type"}
    ],
    "samples": {
        "orgnr": "999999999",
        "navn": "EKSEMPEL AS",
        "dato": "2026-05-20",
        "kunngjoring_type": "Konkursåpning",
        "category": "konkurs",
        "hendelse_type": "konkurs"
    }
}
