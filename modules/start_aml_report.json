{
    "name": "start_aml_report",
    "label": "Start AML report (async)",
    "description": "Start generating an AML report asynchronously for a company — returns immediately with a report_id and status 'pending'. Poll with 'Get AML report' until status is 'done'. Use instead of the synchronous AML score for large/complex ownership structures that may otherwise time out, or to start many screenings in parallel. Requires a signed DPA + per-call confirmation (sent as headers). Rate limit: 50 calls / 30 min. The report is stored for 60 months (Hvitvaskingsloven §35).",
    "connection": "apiKey",
    "type": "action",
    "parameters": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organisation number",
            "required": true,
            "help": "9-digit Norwegian organisation number.",
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Organisation number must be exactly 9 digits."
            }
        },
        {
            "name": "purpose",
            "type": "select",
            "label": "Purpose of screening",
            "required": true,
            "default": "kyc_onboarding",
            "help": "Sent as the DPA purpose (X-FR-Purpose header). Used for the audit trail and rate-limiting policy.",
            "options": [
                {"label": "KYC onboarding (new customer)", "value": "kyc_onboarding"},
                {"label": "KYC review (existing customer)", "value": "kyc_review"},
                {"label": "Risk monitoring", "value": "risk_monitoring"},
                {"label": "Manual request", "value": "manual"}
            ]
        }
    ],
    "communication": {
        "url": "{{connection.baseUrl}}/api/v1/aml/report",
        "method": "POST",
        "headers": {
            "Authorization": "Bearer {{connection.apiKey}}",
            "X-FR-Client": "make-firmaradar/0.1",
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-FR-Purpose": "{{parameters.purpose}}",
            "X-FR-DPA-Confirmed": "true"
        },
        "body": {
            "orgnr": "{{parameters.orgnr}}",
            "purpose": "{{parameters.purpose}}"
        },
        "response": {
            "output": "{{body}}",
            "error": {
                "message": "[{{statusCode}}] {{ifempty(body.error_code, '')}} {{ifempty(body.message, body.error)}}"
            }
        }
    },
    "interface": [
        {"name": "rapport_id", "type": "text", "label": "Rapport-/job-ID (poll denne)"},
        {"name": "orgnr", "type": "text", "label": "Organisasjonsnummer"},
        {"name": "status", "type": "text", "label": "Status (pending/running/done/failed)"},
        {"name": "poll_url", "type": "text", "label": "Poll-URL"}
    ],
    "samples": {
        "rapport_id": "0123456789abcdef0123456789abcdef",
        "orgnr": "999999999",
        "status": "pending",
        "poll_url": "/ext/aml_rapport/job/0123456789abcdef0123456789abcdef"
    }
}
