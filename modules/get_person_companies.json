{
    "name": "get_person_companies",
    "label": "Get person shareholdings",
    "description": "Retrieves every company a person holds shares in, with ownership percentage, share count and the company's total share count. Uses the stable owner-person key from ‘Search persons’. Requires full-search access. Birth year is masked to a 4-digit year. No monetary valuation is returned — neither per holding nor in total.",
    "connection": "apiKey",
    "type": "action",
    "parameters": [
        {
            "help": "Stable owner-person key returned by ‘Search persons’.",
            "name": "owner_person_key",
            "type": "text",
            "label": "Owner-person key",
            "required": true
        }
    ],
    "communication": {
        "url": "/api/v1/person/shareholdings/{{parameters.owner_person_key}}",
        "method": "GET",
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
        {
            "name": "owner_person_key",
            "type": "text",
            "label": "Owner-person key"
        },
        {
            "name": "owner_name",
            "type": "text",
            "label": "Owner name"
        },
        {
            "name": "birth_year",
            "type": "text",
            "label": "Birth year (masked)"
        },
        {
            "name": "poststed",
            "type": "text",
            "label": "Postal town"
        },
        {
            "name": "country_code",
            "type": "text",
            "label": "Country code"
        },
        {
            "name": "shareholdings",
            "type": "array",
            "label": "Shareholdings",
            "spec": {
                "type": "collection",
                "spec": [
                    {
                        "name": "child_orgnr",
                        "type": "text",
                        "label": "Company organization number"
                    },
                    {
                        "name": "company_name",
                        "type": "text",
                        "label": "Company name"
                    },
                    {
                        "name": "founded_year",
                        "type": "uinteger",
                        "label": "Founded year"
                    },
                    {
                        "name": "ownership_pct",
                        "type": "number",
                        "label": "Ownership percentage"
                    },
                    {
                        "name": "share_count",
                        "type": "uinteger",
                        "label": "Share count"
                    },
                    {
                        "name": "company_total_shares",
                        "type": "uinteger",
                        "label": "Company total shares"
                    }
                ]
            }
        },
        {
            "name": "source",
            "type": "text",
            "label": "Source"
        },
        {
            "name": "source_label",
            "type": "text",
            "label": "Source label"
        }
    ],
    "samples": {
        "owner_person_key": "person-1975-aaaaaaaabbbbccccddddeeee",
        "owner_name": "Ola Nordmann",
        "birth_year": "1975",
        "poststed": "STAVANGER",
        "country_code": "NO",
        "shareholdings": [
            {
                "child_orgnr": "912345678",
                "company_name": "NORDMANN HOLDING AS",
                "founded_year": 2011,
                "ownership_pct": 62.5,
                "share_count": 625,
                "company_total_shares": 1000
            }
        ],
        "source": "aksjeeierbok",
        "source_label": "Aksjeeierboken (Skatteetaten)"
    }
}
