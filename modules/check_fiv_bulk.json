{
    "name": "check_fiv_bulk",
    "label": "Bulk: distress check (FIV)",
    "description": "Screens a portfolio of up to 50 companies for distress (GBER art. 2(18), criteria a–e) in one call. Each orgnr is assessed independently; per-orgnr failures are embedded in results[].error while the outer response stays 200. The distress assessment has no organization-form gate — a sole proprietorship (ENK) is assessed like any other company. invalid_orgnr is the only GATE code. The extension-invocation layer can also place extension_not_active, extension_controls_unavailable, data_provider_failed, handler_not_found, handler_http_exception, handler_failed or unexpected_handler_return there; runtime controls expose the stable code in results[].error_code: rate_limit_exceeded, compliance_gate_revoked, compliance_gate_expired, compliance_gate_manifest_unavailable or compliance_gate_unavailable. Which gate reasons can occur follows the extension manifest, and this module requires no external authorization. results[].error_code covers the runtime controls only — dispatcher and bulk-runner failures carry results[].error alone. Their existing results[].error value is preserved and can be human-readable; the bulk runner can add internal_error. Always branch on results[].error before consuming a result. Each orgnr counts as one unit against your quota.",
    "connection": "apiKey",
    "type": "action",
    "parameters": [
        {
            "help": "1–50 nine-digit Norwegian organization numbers (orgnr). Each orgnr counts as one unit against your quota.",
            "name": "orgnrs",
            "spec": {
                "name": "orgnr",
                "type": "text",
                "label": "Organization number",
                "validate": {
                    "pattern": "^[0-9]{9}$",
                    "patternErrorMessage": "Must be exactly 9 digits."
                }
            },
            "type": "array",
            "label": "Organization numbers (max 50)",
            "required": true
        },
        {
            "help": "Accept FIV data even if the underlying financials/BRREG snapshot is older than the normal freshness window (retrospective screening).",
            "name": "skip_freshness",
            "type": "boolean",
            "label": "Skip freshness window",
            "default": false,
            "required": false
        }
    ],
    "communication": {
        "url": "/api/v1/fiv/bulk",
        "method": "POST",
        "body": {
            "orgnrs": "{{parameters.orgnrs}}",
            "skip_freshness": "{{parameters.skip_freshness}}"
        },
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
