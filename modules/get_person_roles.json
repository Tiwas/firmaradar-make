{
    "name": "get_person_roles",
    "label": "Get person roles",
    "description": "Retrieves the complete role history (active + historical) a person has held across companies — board, CEO, signature, power of procuration, auditor. Uses the stable role-person ID from ‘Search persons’. Requires full-search access. Birth year is masked to a 4-digit year.",
    "connection": "apiKey",
    "type": "action",
    "parameters": [
        {
            "help": "Stable role-person key returned by ‘Search persons’.",
            "name": "role_person_id",
            "type": "text",
            "label": "Role-person ID",
            "required": true
        }
    ],
    "communication": {
        "url": "/api/v1/person/roles/{{parameters.role_person_id}}",
        "method": "GET",
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
        {
            "name": "role_person_id",
            "type": "text",
            "label": "Role-person ID"
        },
        {
            "name": "name",
            "type": "text",
            "label": "Name"
        },
        {
            "name": "birth_year",
            "type": "text",
            "label": "Birth year (masked)"
        },
        {
            "name": "companies",
            "type": "array",
            "label": "Role history per company",
            "spec": {
                "type": "collection",
                "spec": [
                    {
                        "name": "orgnr",
                        "type": "text",
                        "label": "Organization number"
                    },
                    {
                        "name": "company_name",
                        "type": "text",
                        "label": "Company name"
                    },
                    {
                        "name": "role_types",
                        "type": "array",
                        "label": "Roles held"
                    },
                    {
                        "name": "active",
                        "type": "boolean",
                        "label": "Currently active"
                    },
                    {
                        "name": "founded_year",
                        "type": "uinteger",
                        "label": "Founded year"
                    }
                ]
            }
        },
        {
            "name": "company_count",
            "type": "uinteger",
            "label": "Number of companies"
        },
        {
            "name": "active_company_count",
            "type": "uinteger",
            "label": "Number where the role is active"
        },
        {
            "name": "konkurs_eksponering",
            "type": "collection",
            "label": "Bankruptcy exposure — NAME-BASED review flag, not a confirmed identity match",
            "spec": [
                {
                    "name": "antall_konkursforetak",
                    "type": "uinteger",
                    "label": "Number of bankrupt companies with a leading role"
                },
                {
                    "name": "foretak",
                    "type": "array",
                    "label": "The affected companies, most recent bankruptcy first",
                    "spec": {
                        "type": "collection",
                        "spec": [
                            {
                                "name": "orgnr",
                                "type": "text",
                                "label": "Organization number"
                            },
                            {
                                "name": "rolletype",
                                "type": "text",
                                "label": "Role held"
                            },
                            {
                                "name": "konkursdato",
                                "type": "text",
                                "label": "Bankruptcy date (YYYY-MM-DD)"
                            },
                            {
                                "name": "tiltradt",
                                "type": "text",
                                "label": "Role assumed (YYYY-MM-DD)"
                            },
                            {
                                "name": "tenure_days",
                                "type": "uinteger",
                                "label": "Days in the role"
                            }
                        ]
                    }
                },
                {
                    "name": "note",
                    "type": "text",
                    "label": "🚨 Read this before acting. Name match without a national ID — a flag for review, not a verdict. Verify identity before deciding."
                }
            ]
        },
        {
            "name": "source",
            "type": "text",
            "label": "Source"
        },
        {
            "name": "source_label",
            "type": "text",
            "label": "Source label"
        }
    ],
    "samples": {
        "role_person_id": "role-aaaaaaaabbbbccccddddeeee",
        "name": "Ola Nordmann",
        "birth_year": "1975",
        "companies": [
            {
                "orgnr": "912345678",
                "company_name": "NORDMANN HOLDING AS",
                "role_types": [
                    "Styreleder"
                ],
                "active": true,
                "founded_year": 2011
            }
        ],
        "company_count": 1,
        "active_company_count": 1,
        "konkurs_eksponering": {
            "antall_konkursforetak": 0,
            "foretak": [],
            "note": ""
        },
        "source": "brreg_enhetsregisteret",
        "source_label": "Brønnøysundregistrene (Enhetsregisteret)"
    }
}
