{
    "name": "get_signals",
    "label": "Get risk signals",
    "description": "Retrieves company signals from multiple sources in one call: KYC announcements, distress classification (FIV), interim balances, ownership, hiring and other enrichment. The aggregate contains indicator flags and a KYC announcement count; inspect each source's error field before interpreting a negative flag.",
    "connection": "apiKey",
    "type": "action",
    "parameters": [
        {
            "help": "Nine-digit Norwegian organization number (orgnr).",
            "name": "orgnr",
            "type": "text",
            "label": "Organization number",
            "required": true,
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Must be exactly 9 digits."
            }
        },
        {
            "help": "Optional look-back start. 🚨 Applies ONLY to the announcement-based kyc_signals. Distress, interim balance, ownership churn, hiring, funding, IP, merger and the other sources report their CURRENT state and are unaffected — an old state signal is NOT excluded by this window. Capped at 1825 days back by the route.",
            "name": "since",
            "type": "date",
            "label": "Signals since (date)"
        }
    ],
    "communication": {
        "url": "/api/v1/company/{{parameters.orgnr}}/signals",
        "method": "GET",
        "qs": {
            "since": "{{formatDate(parameters.since, 'YYYY-MM-DD')}}"
        },
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organization number"
        },
        {
            "name": "days_back",
            "type": "uinteger",
            "label": "Window (days back)"
        },
        {
            "name": "kyc_signals",
            "spec": [
                {
                    "name": "count",
                    "type": "uinteger",
                    "label": "Number of signals"
                },
                {
                    "name": "signals",
                    "spec": {
                        "spec": [
                            {
                                "name": "dato",
                                "type": "text",
                                "label": "Date; ISO date-only string (e.g. 2026-05-12), not a datetime"
                            },
                            {
                                "name": "kunngjoring_type",
                                "type": "text",
                                "label": "Announcement type"
                            },
                            {
                                "name": "kyc_category",
                                "type": "text",
                                "label": "KYC category"
                            },
                            {
                                "name": "niva1_label",
                                "type": "text",
                                "label": "Announcement category label"
                            },
                            {
                                "name": "orgnr",
                                "type": "text",
                                "label": "Organization number"
                            },
                            {
                                "name": "navn",
                                "type": "text",
                                "label": "Company name"
                            },
                            {
                                "name": "hendelse_type",
                                "type": "text",
                                "label": "Event type"
                            },
                            {
                                "name": "category",
                                "type": "text",
                                "label": "Event category"
                            },
                            {
                                "name": "source",
                                "type": "text",
                                "label": "Source"
                            }
                        ],
                        "type": "collection"
                    },
                    "type": "array",
                    "label": "Signals"
                },
                {
                    "name": "effective_window_days",
                    "type": "uinteger",
                    "label": "Window actually applied — can be narrower than days_back"
                },
                {
                    "name": "history_truncated",
                    "type": "boolean",
                    "label": "🚨 Announcement history was CAPPED — the signal list is incomplete"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "🚨 Set when THIS source failed. The aggregate then counts the source as absent, which reads like a negative result — check this before trusting it."
                }
            ],
            "type": "collection",
            "label": "KYC signals (announcements)"
        },
        {
            "name": "distress",
            "spec": [
                {
                    "name": "status",
                    "type": "text",
                    "label": "Status"
                },
                {
                    "name": "status_en",
                    "type": "text",
                    "label": "Status (English)"
                },
                {
                    "name": "disclaimers",
                    "type": "array",
                    "label": "Disclaimers attached to this classification"
                },
                {
                    "name": "data_gaps",
                    "type": "array",
                    "label": "Inputs that were missing"
                },
                {
                    "name": "coverage",
                    "type": "text",
                    "label": "'complete' or 'incomplete' — incomplete means the verdict is NOT fully assessed"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "🚨 Set when THIS source failed. The aggregate then counts the source as absent, which reads like a negative result — check this before trusting it."
                }
            ],
            "type": "collection",
            "label": "Distress classification (FIV) — read coverage, data_gaps and disclaimers before treating a negative status as clean"
        },
        {
            "name": "interim_balance",
            "spec": [
                {
                    "name": "kunngjoring_dato",
                    "type": "text",
                    "label": "Announcement date (YYYY-MM-DD)"
                },
                {
                    "name": "regnskapsperiode_dato",
                    "type": "text",
                    "label": "Accounting period date (YYYY-MM-DD)"
                },
                {
                    "name": "source",
                    "type": "text",
                    "label": "Source"
                },
                {
                    "name": "is_newer_than_metrics",
                    "type": "boolean",
                    "label": "Newer than available financial metrics"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "🚨 Set when THIS source failed. The aggregate then counts the source as absent, which reads like a negative result — check this before trusting it."
                }
            ],
            "type": "collection",
            "label": "Interim balance"
        },
        {
            "name": "aggregate",
            "spec": [
                {
                    "name": "kyc_signal_count",
                    "type": "uinteger",
                    "label": "Number of KYC announcement signals"
                },
                {
                    "name": "has_distress",
                    "type": "boolean",
                    "label": "FIV status is distressed; inspect coverage and data gaps"
                },
                {
                    "name": "has_interim_balance",
                    "type": "boolean",
                    "label": "Interim balance signal is present"
                },
                {
                    "name": "is_hiring_burst",
                    "type": "boolean",
                    "label": "Hiring burst signal"
                },
                {
                    "name": "has_fusjon_relations",
                    "type": "boolean",
                    "label": "Merger or demerger relations exist"
                },
                {
                    "name": "is_frivillig_registered",
                    "type": "boolean",
                    "label": "Registered in the voluntary register"
                },
                {
                    "name": "has_frequent_owner_change",
                    "type": "boolean",
                    "label": "Frequent majority-owner changes"
                }
            ],
            "type": "collection",
            "label": "Combined aggregate. 🚨 Built from default false/zero values when a source fails — it carries NO error of its own. Inspect each source's error field before reading a negative aggregate as a real negative."
        },
        {
            "name": "beneficial_owners",
            "type": "collection",
            "label": "Beneficial-owner signal",
            "spec": [
                {
                    "name": "available",
                    "type": "boolean",
                    "label": "Whether the RRH lookup returned data"
                },
                {
                    "name": "reason",
                    "type": "text",
                    "label": "Why unavailable when available is false"
                },
                {
                    "name": "owners",
                    "type": "array",
                    "label": "Beneficial owners (RRH)",
                    "spec": {
                        "type": "collection",
                        "spec": [
                            {
                                "name": "navn",
                                "type": "text",
                                "label": "Name"
                            },
                            {
                                "name": "foedselsaar",
                                "type": "text",
                                "label": "Birth year"
                            },
                            {
                                "name": "statsborgerskap",
                                "type": "any",
                                "label": "Citizenship; text, or an array of codes when the person holds several"
                            },
                            {
                                "name": "bostedsland",
                                "type": "any",
                                "label": "Country of residence; text, or an array when several values are registered"
                            },
                            {
                                "name": "kontrollgrunnlag",
                                "type": "any",
                                "label": "Basis of control — why this person is a beneficial owner; an array of codes from posisjoner[], or a single text value from registrertGrunnlag"
                            },
                            {
                                "name": "andel_prosent",
                                "type": "number",
                                "label": "Ownership share (%)"
                            },
                            {
                                "name": "andel_intervall",
                                "type": "array",
                                "label": "Share interval, when only a band is reported; always an array when present"
                            }
                        ]
                    }
                },
                {
                    "name": "source",
                    "type": "text",
                    "label": "Source ('brreg_rrh')"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "🚨 Set when THIS source failed. The aggregate then counts the source as absent, which reads like a negative result — check this before trusting it."
                }
            ]
        },
        {
            "name": "ownership_churn",
            "type": "collection",
            "label": "Ownership churn signal",
            "spec": [
                {
                    "name": "changes_total",
                    "type": "uinteger",
                    "label": "Owner changes in total"
                },
                {
                    "name": "changes_in_window",
                    "type": "uinteger",
                    "label": "Owner changes inside the window"
                },
                {
                    "name": "window_months",
                    "type": "uinteger",
                    "label": "Window length (months)"
                },
                {
                    "name": "threshold",
                    "type": "uinteger",
                    "label": "Threshold that triggers the signal"
                },
                {
                    "name": "last_change_date",
                    "type": "text",
                    "label": "Most recent owner change (YYYY-MM-DD)"
                },
                {
                    "name": "period_months",
                    "type": "uinteger",
                    "label": "Period covered (months)"
                },
                {
                    "name": "is_frequent_owner_change",
                    "type": "boolean",
                    "label": "Signal fired"
                },
                {
                    "name": "calibrated",
                    "type": "boolean",
                    "label": "Threshold is calibrated for this population"
                },
                {
                    "name": "source",
                    "type": "text",
                    "label": "Source ('ownership_snapshot')"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "🚨 Set when THIS source failed. The aggregate then counts the source as absent, which reads like a negative result — check this before trusting it."
                }
            ]
        },
        {
            "name": "fusjon",
            "type": "collection",
            "label": "Merger/demerger relations",
            "spec": [
                {
                    "name": "orgnr",
                    "type": "text",
                    "label": "Organization number"
                },
                {
                    "name": "has_any",
                    "type": "boolean",
                    "label": "Any merger relation exists"
                },
                {
                    "name": "inbound",
                    "type": "array",
                    "label": "Companies merged INTO this one — it inherits them",
                    "spec": {
                        "type": "collection",
                        "spec": [
                            {
                                "name": "orgnr",
                                "type": "text",
                                "label": "Organization number of the other party"
                            },
                            {
                                "name": "fusjon_dato",
                                "type": "text",
                                "label": "Merger date"
                            },
                            {
                                "name": "kilde",
                                "type": "text",
                                "label": "Source"
                            },
                            {
                                "name": "relasjon_type",
                                "type": "text",
                                "label": "'fusjon', 'fisjon' or 'ukjent' (untyped — treated as fusjon)"
                            }
                        ]
                    }
                },
                {
                    "name": "outbound",
                    "type": "array",
                    "label": "Companies this one was merged INTO",
                    "spec": {
                        "type": "collection",
                        "spec": [
                            {
                                "name": "orgnr",
                                "type": "text",
                                "label": "Organization number of the other party"
                            },
                            {
                                "name": "fusjon_dato",
                                "type": "text",
                                "label": "Merger date"
                            },
                            {
                                "name": "kilde",
                                "type": "text",
                                "label": "Source"
                            },
                            {
                                "name": "relasjon_type",
                                "type": "text",
                                "label": "'fusjon', 'fisjon' or 'ukjent' (untyped — treated as fusjon)"
                            }
                        ]
                    }
                },
                {
                    "name": "inbound_total",
                    "type": "uinteger",
                    "label": "Total inbound relations"
                },
                {
                    "name": "outbound_total",
                    "type": "uinteger",
                    "label": "Total outbound relations"
                },
                {
                    "name": "truncated",
                    "type": "boolean",
                    "label": "Lists capped — totals exceed what is returned"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "🚨 Set when THIS source failed. The aggregate then counts the source as absent, which reads like a negative result — check this before trusting it."
                }
            ]
        },
        {
            "name": "funding",
            "type": "collection",
            "label": "Funding signal — grants and R&D activity",
            "spec": [
                {
                    "name": "grant_count",
                    "type": "uinteger",
                    "label": "Number of grants"
                },
                {
                    "name": "total_belop_nok",
                    "type": "number",
                    "label": "Total amount (NOK)"
                },
                {
                    "name": "latest_year",
                    "type": "uinteger",
                    "label": "Most recent grant year"
                },
                {
                    "name": "kilder",
                    "type": "array",
                    "label": "Distinct sources"
                },
                {
                    "name": "is_recently_funded",
                    "type": "boolean",
                    "label": "Recently funded"
                },
                {
                    "name": "is_rd_active",
                    "type": "boolean",
                    "label": "R&D active"
                },
                {
                    "name": "source",
                    "type": "text",
                    "label": "Source ('tildeling_data')"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "🚨 Set when THIS source failed. The aggregate then counts the source as absent, which reads like a negative result — check this before trusting it."
                }
            ]
        },
        {
            "name": "hiring",
            "type": "collection",
            "label": "Hiring signal",
            "spec": [
                {
                    "name": "active_postings",
                    "type": "uinteger",
                    "label": "Active job postings"
                },
                {
                    "name": "positions_active",
                    "type": "uinteger",
                    "label": "Positions in those postings"
                },
                {
                    "name": "postings_30d",
                    "type": "uinteger",
                    "label": "Postings last 30 days"
                },
                {
                    "name": "postings_90d",
                    "type": "uinteger",
                    "label": "Postings last 90 days"
                },
                {
                    "name": "burst_score",
                    "type": "number",
                    "label": "Burst score"
                },
                {
                    "name": "is_hiring_burst",
                    "type": "boolean",
                    "label": "Hiring burst detected"
                },
                {
                    "name": "source",
                    "type": "text",
                    "label": "Source ('nav_arbeidsplassen')"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "🚨 Set when THIS source failed. The aggregate then counts the source as absent, which reads like a negative result — check this before trusting it."
                }
            ]
        },
        {
            "name": "ip_portfolio",
            "type": "collection",
            "label": "IP portfolio (Patentstyret)",
            "spec": [
                {
                    "name": "available",
                    "type": "boolean",
                    "label": "Lookup completed"
                },
                {
                    "name": "reason",
                    "type": "text",
                    "label": "Why unavailable (not_enabled/no_key/access_denied/kilde_utilgjengelig/…)"
                },
                {
                    "name": "patents",
                    "type": "uinteger",
                    "label": "Patents"
                },
                {
                    "name": "patents_active",
                    "type": "uinteger",
                    "label": "Active patents"
                },
                {
                    "name": "trademarks",
                    "type": "uinteger",
                    "label": "Trademarks"
                },
                {
                    "name": "trademarks_active",
                    "type": "uinteger",
                    "label": "Active trademarks"
                },
                {
                    "name": "designs",
                    "type": "uinteger",
                    "label": "Designs"
                },
                {
                    "name": "designs_active",
                    "type": "uinteger",
                    "label": "Active designs"
                },
                {
                    "name": "is_ip_active",
                    "type": "boolean",
                    "label": "Holds at least one right in force"
                },
                {
                    "name": "rights",
                    "type": "array",
                    "label": "Rights in force — active first, then by type, then by date",
                    "spec": {
                        "type": "collection",
                        "spec": [
                            {
                                "name": "kind",
                                "type": "text",
                                "label": "'patent', 'trademark' or 'design'"
                            },
                            {
                                "name": "title",
                                "type": "text",
                                "label": "Title"
                            },
                            {
                                "name": "regnr",
                                "type": "text",
                                "label": "Registration number"
                            },
                            {
                                "name": "status",
                                "type": "text",
                                "label": "Status"
                            },
                            {
                                "name": "date",
                                "type": "text",
                                "label": "Status date"
                            },
                            {
                                "name": "is_active",
                                "type": "boolean",
                                "label": "In force"
                            }
                        ]
                    }
                },
                {
                    "name": "rights_more",
                    "type": "uinteger",
                    "label": "Rights in force beyond the cap"
                },
                {
                    "name": "rights_all",
                    "type": "array",
                    "label": "All rights, in force and lapsed",
                    "spec": {
                        "type": "collection",
                        "spec": [
                            {
                                "name": "kind",
                                "type": "text",
                                "label": "'patent', 'trademark' or 'design'"
                            },
                            {
                                "name": "title",
                                "type": "text",
                                "label": "Title"
                            },
                            {
                                "name": "regnr",
                                "type": "text",
                                "label": "Registration number"
                            },
                            {
                                "name": "status",
                                "type": "text",
                                "label": "Status"
                            },
                            {
                                "name": "date",
                                "type": "text",
                                "label": "Status date"
                            },
                            {
                                "name": "is_active",
                                "type": "boolean",
                                "label": "In force"
                            }
                        ]
                    }
                },
                {
                    "name": "rights_all_more",
                    "type": "uinteger",
                    "label": "Rights beyond the cap in rights_all"
                },
                {
                    "name": "rights_inactive",
                    "type": "uinteger",
                    "label": "Lapsed rights"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "🚨 Set when THIS source failed. The aggregate then counts the source as absent, which reads like a negative result — check this before trusting it."
                }
            ]
        },
        {
            "name": "digital_maturity",
            "type": "collection",
            "label": "Digital maturity signal",
            "spec": [
                {
                    "name": "peppol_einvoice",
                    "type": "boolean",
                    "label": "Registered for Peppol e-invoicing"
                },
                {
                    "name": "peppol_name",
                    "type": "text",
                    "label": "Name in the Peppol directory"
