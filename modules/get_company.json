{
    "name": "get_company",
    "label": "Get company",
    "description": "Retrieves core company information by 9-digit Norwegian organization number (orgnr).",
    "connection": "apiKey",
    "type": "action",
    "crud": "read",
    "parameters": [
        {
            "help": "Nine-digit Norwegian organization number (orgnr) from Brønnøysundregistrene (Norwegian Business Register).",
            "name": "orgnr",
            "type": "text",
            "label": "Organization number",
            "required": true,
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Organization number must be exactly 9 digits."
            }
        }
    ],
    "communication": {
        "url": "/api/v1/company/{{parameters.orgnr}}/basic",
        "method": "GET",
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organization number"
        },
        {
            "name": "navn",
            "type": "text",
            "label": "Name"
        },
        {
            "name": "organisasjonsform",
            "type": "text",
            "label": "Legal form"
        },
        {
            "name": "status",
            "type": "text",
            "label": "Status (aktiv/konkurs/under_avvikling/under_tvangsavvikling)"
        },
        {
            "name": "registreringsdato",
            "type": "text",
            "label": "Registration date"
        },
        {
            "name": "stiftelsesdato",
            "type": "text",
            "label": "Incorporation date"
        },
        {
            "name": "antall_ansatte",
            "type": "number",
            "label": "Number of employees"
        },
        {
            "name": "naeringskode",
            "type": "text",
            "label": "NACE code"
        },
        {
            "name": "naeringskode_beskrivelse",
            "type": "text",
            "label": "NACE description"
        },
        {
            "name": "siste_aarsregnskap",
            "type": "text",
            "label": "Latest accounting year — TEXT, e.g. '2025' (the column is TEXT and is passed through unchanged)"
        },
        {
            "name": "er_i_konsern",
            "type": "boolean",
            "label": "Part of a group"
        },
        {
            "name": "kapital_belop",
            "type": "number",
            "label": "Share capital (amount)"
        },
        {
            "name": "kapital_valuta",
            "type": "text",
            "label": "Share capital (currency)"
        },
        {
            "name": "mva_registrert",
            "type": "boolean",
            "label": "VAT registered"
        },
        {
            "name": "konkurs",
            "type": "boolean",
            "label": "Bankrupt"
        },
        {
            "name": "konkursdato",
            "type": "text",
            "label": "Bankruptcy date"
        },
        {
            "name": "under_avvikling",
            "type": "boolean",
            "label": "Under liquidation"
        },
        {
            "name": "avviklingsdato",
            "type": "text",
            "label": "Liquidation date"
        },
        {
            "name": "under_tvangsavvikling",
            "type": "boolean",
            "label": "Under compulsory liquidation"
        },
        {
            "name": "forr_adresse",
            "type": "text",
            "label": "Business address"
        },
        {
            "name": "forr_postnummer",
            "type": "text",
            "label": "Postal code"
        },
        {
            "name": "forr_poststed",
            "type": "text",
            "label": "Postal town"
        },
        {
            "name": "forr_kommune",
            "type": "text",
            "label": "Municipality"
        },
        {
            "name": "forr_landkode",
            "type": "text",
            "label": "Country code"
        },
        {
            "name": "epost",
            "type": "text",
            "label": "Email"
        },
        {
            "name": "telefon",
            "type": "text",
            "label": "Phone"
        },
        {
            "name": "mobil",
            "type": "text",
            "label": "Mobile"
        },
        {
            "name": "hjemmeside",
            "type": "url",
            "label": "Website"
        }
    ],
    "samples": {
        "orgnr": "923609016",
        "navn": "EQUINOR ASA",
        "organisasjonsform": "ASA",
        "registreringsdato": "1995-03-12",
        "stiftelsesdato": "1972-09-18",
        "antall_ansatte": 21327,
        "naeringskode": "06.100",
        "naeringskode_beskrivelse": "Utvinning av råolje",
        "siste_aarsregnskap": "2024",
        "er_i_konsern": true,
        "kapital_belop": 6392018780,
        "kapital_valuta": "NOK",
        "mva_registrert": true,
        "konkurs": false,
        "under_avvikling": false,
        "under_tvangsavvikling": false,
        "forr_adresse": "Forusbeen 50",
        "forr_postnummer": "4035",
        "forr_poststed": "STAVANGER",
        "forr_kommune": "STAVANGER",
        "forr_landkode": "NO",
        "hjemmeside": "www.equinor.com",
        "telefon": "51 99 00 00",
        "status": "aktiv"
    }
}
