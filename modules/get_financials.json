{
    "name": "get_financials",
    "label": "Get financials",
    "description": "Retrieves financial history (operating revenue, operating profit, profit for the year, total assets, equity and liabilities) for up to 10 years back. Returns ONE statement type per call: company accounts (SELSKAP) when they exist, otherwise consolidated group accounts (KONSERN). The regnskapstype output field tells you which set you received.",
    "connection": "apiKey",
    "type": "action",
    "crud": "read",
    "parameters": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organization number",
            "required": true,
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Must be exactly 9 digits."
            }
        },
        {
            "name": "years",
            "type": "uinteger",
            "label": "Years of history",
            "default": 5,
            "help": "Number of accounting years to return (1-10).",
            "validate": {
                "min": 1,
                "max": 10
            }
        }
    ],
    "communication": {
        "url": "/api/regnskap/{{parameters.orgnr}}/historikk",
        "method": "GET",
        "response": {
            "output": "{{body}}"
        },
        "qs": {
            "years": "{{parameters.years}}"
        }
    },
    "interface": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organization number"
        },
        {
            "name": "regnskapstype",
            "type": "text",
            "label": "Statement type (SELSKAP/KONSERN)"
        },
        {
            "name": "antall_ansatte",
            "type": "uinteger",
            "label": "Current headcount (not tied to an accounting year)"
        },
        {
            "name": "items",
            "type": "array",
            "label": "Accounting years, newest first",
            "spec": {
                "type": "collection",
                "spec": [
                    {
                        "name": "regnskapsar",
                        "type": "uinteger",
                        "label": "Accounting year"
                    },
                    {
                        "name": "driftsinntekter",
                        "type": "number",
                        "label": "Operating revenue"
                    },
                    {
                        "name": "driftsresultat",
                        "type": "number",
                        "label": "Operating profit"
                    },
                    {
                        "name": "aarsresultat",
                        "type": "number",
                        "label": "Profit for the year"
                    },
                    {
                        "name": "egenkapital",
                        "type": "number",
                        "label": "Equity"
                    },
                    {
                        "name": "sum_gjeld",
                        "type": "number",
                        "label": "Total liabilities"
                    },
                    {
                        "name": "sum_eiendeler",
                        "type": "number",
                        "label": "Total assets"
                    }
                ]
            }
        },
        {
            "name": "paywall",
            "type": "collection",
            "label": "Paywall diagnosis — present only when the raw figures were withheld; empty for callers with an active plan",
            "spec": [
                {
                    "name": "metrics_omitted",
                    "type": "boolean",
                    "label": "Raw figures were withheld: items is empty and the per-year amounts are absent"
                },
                {
                    "name": "headcount_omitted",
                    "type": "boolean",
                    "label": "A current headcount existed but was withheld. False means the register simply had none — check this before reading an empty headcount as paywalled"
                },
                {
                    "name": "reason",
                    "type": "text",
                    "label": "Why the figures were withheld: tier_required (the producer states an active API/MCP/machine plan is needed) or verification_unavailable (entitlement could not be verified, so the response failed closed — this is NOT proof that the account lacks a subscription)"
                },
                {
                    "name": "message",
                    "type": "text",
                    "label": "Human-readable explanation of the paywall decision"
                },
                {
                    "name": "available_year",
                    "type": "uinteger",
                    "label": "Most recent accounting year that exists behind the paywall"
                }
            ]
        },
        {
            "name": "freshness",
            "type": "collection",
            "label": "Hydration state — poll poll_url while state is queued/pending/running",
            "spec": [
                {
                    "name": "state",
                    "type": "text",
                    "label": "State: none/queued/pending/running/done/failed"
                },
                {
                    "name": "reason",
                    "type": "text",
                    "label": "Why the job was queued"
                },
                {
                    "name": "last_attempt_at",
                    "type": "text",
                    "label": "Last attempt (timestamp)"
                },
                {
                    "name": "last_success_at",
                    "type": "text",
                    "label": "Last success (timestamp)"
                },
                {
                    "name": "error",
                    "type": "text",
                    "label": "Error kind, when state is failed"
                },
                {
                    "name": "poll_url",
                    "type": "text",
                    "label": "URL to poll until state leaves queued/pending/running"
                }
            ]
        },
        {
            "name": "hydrating",
            "type": "boolean",
            "label": "History is still being built — items may be incomplete"
        },
        {
            "name": "count",
            "type": "uinteger",
            "label": "Number of years returned"
        },
        {
            "name": "total_available_years",
            "type": "uinteger",
            "label": "Total years available"
        },
        {
            "name": "available_years",
            "type": "array",
            "label": "Which years exist"
        }
    ]
}
