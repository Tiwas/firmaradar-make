{
    "name": "find_related_companies",
    "label": "Find related companies",
    "description": "Find companies related to a given company through shared people, shared address or shared owners. Useful for network/beneficial-ownership exploration and cluster detection.",
    "connection": "apiKey",
    "type": "search",
    "parameters": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organisation number",
            "required": true,
            "help": "9-digit Norwegian organisation number to expand from.",
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Organisation number must be exactly 9 digits."
            }
        },
        {
            "name": "via",
            "type": "select",
            "label": "Relation type",
            "default": "person",
            "options": [
                {"label": "Shared people (roles)", "value": "person"},
                {"label": "Shared owners", "value": "owner"},
                {"label": "Shared address", "value": "address"}
            ],
            "help": "How companies are considered related."
        },
        {
            "name": "min_overlap",
            "type": "uinteger",
            "label": "Minimum shared entities",
            "default": 1,
            "help": "Minimum number of shared people/owners (for via person/owner)."
        },
        {
            "name": "limit",
            "type": "uinteger",
            "label": "Max results",
            "default": 25,
            "validate": {"min": 1, "max": 100},
            "help": "Maximum number of related companies to return (1-100)."
        }
    ],
    "communication": {
        "url": "{{connection.baseUrl}}/api/v1/company/{{parameters.orgnr}}/related",
        "method": "GET",
        "qs": {
            "via": "{{parameters.via}}",
            "min_overlap": "{{parameters.min_overlap}}",
            "limit": "{{parameters.limit}}"
        },
        "headers": {
            "Authorization": "Bearer {{connection.apiKey}}",
            "X-FR-Client": "make-firmaradar/0.1",
            "Accept": "application/json"
        },
        "response": {
            "output": "{{body.related}}",
            "error": {
                "message": "[{{statusCode}}] {{ifempty(body.error_code, '')}} {{ifempty(body.message, body.error)}}"
            }
        }
    },
    "interface": [
        {"name": "orgnr", "type": "text", "label": "Organisation number"},
        {"name": "navn", "type": "text", "label": "Company name"},
        {"name": "overlap", "type": "uinteger", "label": "Shared entities"}
    ],
    "samples": {
        "orgnr": "999999998",
        "navn": "RELATERT AS",
        "overlap": 2
    }
}
