{
    "name": "get_konsernstotte",
    "label": "Get group public support",
    "description": "Retrieves an overview of public support (state aid) received across the corporate group: direct support to the company (selskap_stotte) and support aggregated up the ownership tree (konsern_aggregat). Fuses NAV grants, COVID-19 support, the BRREG state-aid registry, Innovasjon Norge and SkatteFUNN into one decision-ready overview.",
    "connection": "apiKey",
    "type": "action",
    "parameters": [
        {
            "help": "Nine-digit Norwegian organization number (orgnr).",
            "name": "orgnr",
            "type": "text",
            "label": "Organization number",
            "required": true,
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Must be exactly 9 digits."
            }
        }
    ],
    "communication": {
        "url": "/api/v1/konsernstotte/oversikt/{{parameters.orgnr}}",
        "method": "GET",
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organization number"
        },
        {
            "name": "tre",
            "type": "collection",
            "label": "Ownership tree with direct support per node. Declared field by field to depth 4; the response can contain nodes down to depth 12 — see the barn field at the deepest declared level.",
            "spec": [
                {
                    "name": "orgnr",
                    "type": "text",
                    "label": "Organization number"
                },
                {
                    "name": "navn",
                    "type": "text",
                    "label": "Company name"
                },
                {
                    "name": "navn_konfidens",
                    "type": "text",
                    "label": "Confidence in the resolved name"
                },
                {
                    "name": "antall_underselskaper",
                    "type": "uinteger",
                    "label": "Number of direct subsidiaries"
                },
                {
                    "name": "selskap_stotte",
                    "type": "collection",
                    "label": "Support paid DIRECTLY to this company",
                    "spec": [
                        {
                            "name": "innovasjon_norge",
                            "type": "uinteger",
                            "label": "Grants from Innovasjon Norge"
                        },
                        {
                            "name": "skattefunn",
                            "type": "uinteger",
                            "label": "SkatteFUNN projects"
                        },
                        {
                            "name": "andre",
                            "type": "uinteger",
                            "label": "Other schemes"
                        },
                        {
                            "name": "antall_prosjekter",
                            "type": "uinteger",
                            "label": "Projects in total"
                        },
                        {
                            "name": "total_belop_nok",
                            "type": "number",
                            "label": "Total amount (NOK)"
                        }
                    ]
                },
                {
                    "name": "truncated_at_depth",
                    "type": "boolean",
                    "label": "Tree truncated here — descendants NOT included"
                },
                {
                    "name": "cycle",
                    "type": "boolean",
                    "label": "Circular ownership — traversal stopped"
                },
                {
                    "name": "barn",
                    "type": "array",
                    "label": "Child nodes (depth 2)",
                    "spec": {
