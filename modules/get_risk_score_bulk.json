{
    "name": "get_risk_score_bulk",
    "label": "Bulk: risk score",
    "description": "Scores up to 50 companies for risk (0–100, level and component breakdown). Each orgnr is scored independently. The outer response stays 200; inspect results[].error for each company before using its score. Gate errors include invalid_orgnr, company_not_found, enk_not_supported/blocked_enk (also NUF), orgform_unavailable, kundebekreftelse_required and extension_not_active. Extension and data-provider failures can also appear in results[].error. Runtime control failures use results[].error_code (rate_limit_exceeded or compliance_gate_*); dispatcher and bulk-runner failures may have only results[].error. This module needs no external authorization. Each orgnr counts as one unit against your quota.",
    "connection": "apiKey",
    "type": "action",
    "parameters": [
        {
            "help": "1–50 nine-digit Norwegian organization numbers (orgnr). Each orgnr counts as one unit against your quota.",
            "name": "orgnrs",
            "spec": {
                "name": "orgnr",
                "type": "text",
                "label": "Organization number",
                "validate": {
                    "pattern": "^[0-9]{9}$",
                    "patternErrorMessage": "Must be exactly 9 digits."
                }
            },
            "type": "array",
            "label": "Organization numbers (max 50)",
            "required": true
        }
    ],
    "communication": {
        "url": "/api/v1/risikoscoring/score/bulk",
        "method": "POST",
        "body": {
            "orgnrs": "{{parameters.orgnrs}}"
        },
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
        {
            "name": "results",
            "spec": {
                "spec": [
                    {
                        "name": "orgnr",
                        "type": "text",
                        "label": "Organization number"
                    },
                    {
                        "name": "score",
                        "type": "number",
                        "label": "Score (0–100)"
                    },
                    {
                        "name": "risk_level",
                        "type": "text",
                        "label": "Level (lav/moderat/høy/kritisk)"
                    },
                    {
                        "name": "organisasjonsform",
                        "type": "text",
                        "label": "Organization form that triggered the gate (ENK/NUF)"
                    },
          {
            "name": "error",
            "type": "text",
            "label": "Per-orgnr error (if any)"
          },
          {
            "name": "message",
            "type": "text",
            "label": "Human-readable runtime-control detail"
          },
          {
            "name": "error_code",
            "type": "text",
            "label": "Stable runtime-control error code"
          },
          {
            "name": "retry_after",
            "type": "text",
            "label": "Retry-After value when rate limited"
          },
          {
            "name": "http_status",
            "type": "number",
            "label": "Per-orgnr HTTP status (outer bulk response stays 200)"
          },
          {
            "name": "components",
                        "type": "array",
                        "label": "Component breakdown",
                        "spec": {
                            "type": "collection",
                            "spec": [
                                {
                                    "name": "component_id",
                                    "type": "text",
                                    "label": "Component id"
                                },
                                {
                                    "name": "label",
                                    "type": "text",
                                    "label": "Label"
                                },
                                {
                                    "name": "points",
                                    "type": "number",
                                    "label": "Points"
                                },
                                {
                                    "name": "max_points",
                                    "type": "number",
                                    "label": "Max points"
                                },
                                {
                                    "name": "note",
                                    "type": "text",
                                    "label": "Note"
                                }
                            ]
                        }
                    },
                    {
                        "name": "sources",
                        "type": "array",
                        "label": "Sources used"
                    },
                    {
                        "name": "data_gaps",
                        "type": "array",
                        "label": "Missing inputs — the score is computed DESPITE these"
                    },
                    {
                        "name": "disclaimer",
                        "type": "text",
                        "label": "Usage restriction: not for credit assessment or automated negative decisions"
                    }
                ],
                "type": "collection"
            },
            "type": "array",
            "label": "Per-company results"
        },
        {
            "name": "_meta",
            "spec": [
                {
                    "name": "total_requested",
                    "type": "number",
                    "label": "Number requested"
                },
                {
                    "name": "successful",
                    "type": "number",
                    "label": "Successful"
                },
                {
                    "name": "failed",
                    "type": "number",
                    "label": "Failed"
                }
            ],
            "type": "collection",
            "label": "Aggregate"
        }
    ],
    "samples": {
        "results": [
            {
                "orgnr": "999999999",
                "score": 22,
                "risk_level": "lav",
                "components": []
            },
            {
                "orgnr": "998877665",
                "score": 71,
                "risk_level": "høy",
                "components": []
            }
        ],
        "_meta": {
            "total_requested": 2,
            "successful": 2,
            "failed": 0
        }
    }
}
