{
    "name": "get_announcements",
    "label": "Get company announcements",
    "description": "Retrieves official BRREG announcements (kunngjøringer) for one company — capital, board, approved accounts, forced-dissolution notices and more.",
    "connection": "apiKey",
    "type": "action",
    "public": false,
    "parameters": [
        {
            "name": "orgnr",
            "type": "text",
            "label": "Organization number",
            "required": true,
            "validate": {
                "pattern": "^[0-9]{9}$",
                "patternErrorMessage": "Must be exactly 9 digits."
            }
        },
        {
            "name": "from",
            "type": "date",
            "label": "From date",
            "help": "Default: 30 days back."
        },
        {
            "name": "to",
            "type": "date",
            "label": "To date",
            "help": "Default: today."
        },
        {
            "name": "type",
            "type": "text",
            "label": "Announcement type filter",
            "help": "Case-insensitive substring, e.g. 'fusjon', 'kapital'."
        },
        {
            "name": "limit",
            "type": "uinteger",
            "label": "Max results",
            "default": 50,
            "validate": {
                "min": 1,
                "max": 200
            }
        }
    ],
    "communication": {
        "url": "/api/v1/announcements/search",
        "method": "GET",
        "qs": {
            "orgnr": "{{parameters.orgnr}}",
            "from": "{{formatDate(parameters.from, 'YYYY-MM-DD')}}",
            "to": "{{formatDate(parameters.to, 'YYYY-MM-DD')}}",
            "type": "{{parameters.type}}",
            "limit": "{{parameters.limit}}"
        },
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
        {
            "name": "items",
            "type": "array",
            "label": "Announcements",
            "spec": {
                "type": "collection",
                "spec": [
                    {
                        "name": "orgnr",
                        "type": "text",
                        "label": "Organization number"
                    },
                    {
                        "name": "navn",
                        "type": "text",
                        "label": "Company name"
                    },
                    {
                        "name": "dato",
                        "type": "text",
                        "label": "Date (YYYY-MM-DD)"
                    },
                    {
                        "name": "kunngjoring_type",
                        "type": "text",
                        "label": "Announcement type"
                    },
                    {
                        "name": "category",
                        "type": "text",
                        "label": "Category"
                    },
                    {
                        "name": "hendelse_type",
                        "type": "text",
                        "label": "Event type"
                    }
                ]
            }
        },
        {
            "name": "next_cursor",
            "type": "text",
            "label": "Next cursor"
        }
    ]
}
