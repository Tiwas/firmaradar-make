{
    "name": "compare_companies",
    "label": "Compare companies",
    "description": "Compares the accounting history of 1-5 companies over N years server-side — revenue, result, equity side by side.",
    "connection": "apiKey",
    "type": "action",
    "public": false,
    "parameters": [
        {
            "name": "orgnrs",
            "type": "array",
            "label": "Organization numbers (max 5)",
            "required": true,
            "spec": {
                "name": "value",
                "type": "text",
                "label": "Organization number",
                "validate": {
                    "pattern": "^[0-9]{9}$",
                    "patternErrorMessage": "Must be exactly 9 digits."
                }
            }
        },
        {
            "name": "years",
            "type": "uinteger",
            "label": "Years",
            "default": 5,
            "validate": {
                "min": 1,
                "max": 10
            }
        },
        {
            "name": "metrics",
            "type": "array",
            "label": "Metrics",
            "help": "Optional subset of key figures. Leave empty for the default set.",
            "spec": {
                "name": "value",
                "type": "text",
                "label": "Metric"
            }
        }
    ],
    "communication": {
        "url": "/api/v1/companies/compare",
        "method": "POST",
        "body": {
            "orgnrs": "{{parameters.orgnrs}}",
            "years": "{{parameters.years}}",
            "metrics": "{{parameters.metrics}}"
        },
        "response": {
            "output": "{{body}}"
        }
    },
    "interface": [
        {
            "name": "orgnrs",
            "type": "array",
            "label": "Organization numbers compared"
        },
        {
            "name": "years",
            "type": "array",
            "label": "Years covered, newest first — comparison values are aligned to this order",
            "spec": {
                "type": "uinteger"
            }
        },
        {
            "name": "companies",
            "type": "array",
            "label": "Company metadata",
            "spec": {
                "type": "collection",
                "spec": [
                    {
                        "name": "orgnr",
                        "type": "text",
                        "label": "Organization number"
                    },
                    {
                        "name": "navn",
                        "type": "text",
                        "label": "Company name"
                    },
                    {
                        "name": "financials_by_year",
                        "type": "collection",
                        "label": "Figures per year"
                    },
                    {
                        "name": "antall_ansatte",
                        "type": "uinteger",
                        "label": "Employees"
                    }
                ]
            }
        },
        {
            "name": "comparison",
            "type": "collection",
            "label": "Comparison matrix: metric -> organization number -> aligned year values. Keys are dynamic, so map with a nested reference."
        },
        {
            "name": "computed_at",
            "type": "text",
            "label": "Computed at (timestamp)"
        }
    ]
}
